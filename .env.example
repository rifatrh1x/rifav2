# ── Rifav Environment Variables ──────────────────────────────
# এই ফাইলটি কপি করে `.env` নাম দিন এবং নিচের মানগুলো বসান।

# PostgreSQL connection string (Neon / Supabase / Railway — free tier)
DATABASE_URL=postgresql://user:password@host:5432/rifav?sslmode=require

# Secret for signing auth sessions. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string
